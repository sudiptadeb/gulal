{
  "name": "@debkosh/gulal",
  "version": "0.3.0",
  "description": "Colours made for where they sit: random, seeded or from text, in palettes that sit well together, and for any background the border and inks that read on it.",
  "type": "module",
  "main": "./dist/gulal.js",
  "types": "./dist/gulal.d.ts",
  "exports": {
    ".": {
      "types": "./dist/gulal.d.ts",
      "import": "./dist/gulal.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsc -p .",
    "test": "npm run build && node test/vectors.test.mjs && node test/api.test.mjs",
    "vectors": "npm run build && node test/make-vectors.mjs"
  },
  "keywords": ["color", "colour", "palette", "oklch", "apca", "contrast", "deterministic", "seeded", "harmony"],
  "license": "MIT",
  "author": "Sudipta Deb",
  "repository": { "type": "git", "url": "git+https://github.com/sudiptadeb/gulal.git", "directory": "js" },
  "homepage": "https://debkosh.com/gulal",
  "engines": { "node": ">=18" },
  "devDependencies": {
    "typescript": "5.6.3"
  }
}
